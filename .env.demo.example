# Пример окружения для демо-стенда (docker-compose.demo.yml).
# На сервере скопировать в /docker/checkstock/.env и заменить пароль.
# .env в git не попадает (см. .gitignore).
#
# POSTGRES_PASSWORD и пароль внутри DATABASE_URL должны совпадать.

POSTGRES_USER=checkstock
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=checkstock
DATABASE_URL=postgresql+psycopg://checkstock:change-me-to-a-long-random-value@db:5432/checkstock

# Демо-режим: только просмотр (в docker-compose.demo.yml включён по умолчанию)
DEMO_READ_ONLY=1
